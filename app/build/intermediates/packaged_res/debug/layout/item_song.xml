<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:paddingHorizontal="16dp"
    android:background="@drawable/bg_song_item"
    android:foreground="?attr/selectableItemBackground">

    <!-- Album Art -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAlbumArt"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/bg_elevated"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/ivAlbumArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music_note" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Playing indicator dot -->
    <View
        android:id="@+id/ivPlayingIndicator"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/bg_playing_dot"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/cardAlbumArt"
        app:layout_constraintEnd_toEndOf="@id/cardAlbumArt"
        app:layout_constraintTop_toTopOf="@id/cardAlbumArt"
        app:layout_constraintBottom_toBottomOf="@id/cardAlbumArt" />

    <!-- Song info -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintStart_toEndOf="@id/cardAlbumArt"
        app:layout_constraintEnd_toStartOf="@id/btnFavorite"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvArtist"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.5" />

    <TextView
        android:id="@+id/tvArtist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="4dp"
        android:layout_marginTop="2dp"
        app:layout_constraintStart_toEndOf="@id/cardAlbumArt"
        app:layout_constraintEnd_toStartOf="@id/btnFavorite"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Duration -->
    <TextView
        android:id="@+id/tvDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_tertiary"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@id/btnFavorite"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="8dp" />

    <!-- Favorite button -->
    <ImageButton
        android:id="@+id/btnFavorite"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_favorite_border"
        android:tint="@color/accent_primary"
        android:padding="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
